#!/usr/bin/env bash
set -euo pipefail

for tool in slurp grim tesseract; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Install required OCR tools: sudo pacman -S grim slurp tesseract tesseract-data-eng\n' >&2
        exit 127
    fi
done

sleep 0.3
image_file="$(mktemp --suffix=.png)"
ocr_error="$(mktemp)"
selection_file="$(mktemp)"
selector_pid=""
cleanup() {
    if [[ -n "$selector_pid" ]]; then
        kill "$selector_pid" 2>/dev/null || true
        wait "$selector_pid" 2>/dev/null || true
    fi
    rm -f "$image_file" "$ocr_error" "$selection_file"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
slurp -b '#111722cc' -c '#68d7ffff' -s '#365b9b66' -w 3 >"$selection_file" &
selector_pid=$!
if ! wait "$selector_pid"; then
    exit 130
fi
selector_pid=""
geometry="$(<"$selection_file")"
if [[ -z "$geometry" ]]; then
    exit 130
fi
if ! grim -g "$geometry" "$image_file"; then
    printf 'Could not capture selected screen area (%s).\n' "$geometry" >&2
    exit 1
fi
if [[ ! -s "$image_file" ]]; then
    printf 'Screenshot capture produced an empty image.\n' >&2
    exit 1
fi
printf 'Captured selection %s (%s bytes).\n' "$geometry" "$(stat -c %s "$image_file")" >&2
if ! tesseract "$image_file" stdout -l eng --psm 6 2>"$ocr_error"; then
    cat "$ocr_error" >&2
    exit 1
fi
